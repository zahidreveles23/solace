# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the chat model
# ANTHROPIC_MODEL=claude-opus-4-6

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL of the deployed site, e.g. https://solace.example.com
NEXT_PUBLIC_URL=http://localhost:3000

# Long random string used to sign cookies: `openssl rand -hex 32`
SESSION_SECRET=

# Free messages per day before the paywall
FREE_MESSAGES_PER_DAY=10
